{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true, "isolatedModules": true, "noEmit": true,
    "skipLibCheck": true, "types": ["vite/client", "node"]
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx", "src/contracts/**/*.ts", "tests/web/**/*.ts", "tests/e2e/**/*.ts", "vite.config.ts"]
}
