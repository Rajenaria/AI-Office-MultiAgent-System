{
  "name": "ai-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bounded shared domain and foundation policy contracts for AI Office.",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "vitest run tests/contracts tests/integration/workspace tests/integration/state tests/web",
    "test:web": "vitest run tests/web",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "test:state": "vitest run tests/integration/state",
    "test:workspace": "vitest run tests/integration/workspace",
    "dev:backend": "tsx src/server/index.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
